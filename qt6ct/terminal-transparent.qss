/*
 * Terminal Transparent Qt6 theme
 * Designed for qt6ct. Transparency depends on the app and compositor support.
 */

* {
    font-family: "FiraCode Nerd Font", "Fira Code", "JetBrains Mono", "Monospace";
    font-size: 10pt;
    color: #ffffff;
    selection-color: #ffffff;
    selection-background-color: #767676;
}

QWidget,
QMainWindow,
QDialog,
QMenu,
QToolTip,
QAbstractScrollArea,
QMdiArea,
QWorkspace {
    background-color: rgba(34, 34, 34, 150);
}

QFrame,
QGroupBox,
QTabWidget::pane,
QMenu,
QToolTip {
    border: 1px solid rgba(212, 212, 212, 70);
    border-radius: 6px;
}

QGroupBox {
    margin-top: 1.2em;
    padding: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #767676;
}

QMenu::item,
QListView::item,
QTreeView::item,
QTableView::item,
QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 4px 8px;
}

QMenu::item:selected,
QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected,
QComboBox QAbstractItemView::item:selected {
    color: #ffffff;
    background-color: #767676;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    color: #ffffff;
    background-color: rgba(0, 0, 0, 120);
    border: 1px solid rgba(212, 212, 212, 90);
    border-radius: 6px;
    padding: 5px 8px;
    selection-color: #ffffff;
    selection-background-color: #767676;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: #767676;
}

QPushButton,
QToolButton {
    color: #ffffff;
    background-color: rgba(47, 45, 46, 180);
    border: 1px solid rgba(212, 212, 212, 80);
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton:hover,
QToolButton:hover {
    background-color: rgba(88, 88, 88, 190);
    border-color: #d4d4d4;
}

QPushButton:pressed,
QToolButton:pressed,
QPushButton:checked,
QToolButton:checked {
    color: #ffffff;
    background-color: #767676;
    border-color: #767676;
}

QPushButton:disabled,
QToolButton:disabled,
QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QComboBox:disabled {
    color: #8e8e8e;
    background-color: rgba(34, 34, 34, 90);
    border-color: rgba(142, 142, 142, 55);
}

QCheckBox,
QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 15px;
    height: 15px;
    background-color: rgba(0, 0, 0, 120);
    border: 1px solid rgba(212, 212, 212, 100);
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #767676;
    border-color: #767676;
}

QTabBar::tab {
    color: #b0b0b0;
    background-color: rgba(43, 43, 43, 140);
    border: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 12px;
}

QTabBar::tab:hover {
    color: #ffffff;
    background-color: rgba(63, 63, 63, 224);
    border-top: 1px solid rgba(107, 107, 107, 140);
}

QTabBar::tab:selected {
    color: #ffffff;
    background-color: #4d4d4d;
    border-top: 1px solid rgba(143, 143, 143, 217);
}

QHeaderView::section {
    color: #ffffff;
    background-color: rgba(0, 0, 0, 140);
    border: 0;
    border-right: 1px solid rgba(212, 212, 212, 50);
    border-bottom: 1px solid rgba(212, 212, 212, 50);
    padding: 6px;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: rgba(0, 0, 0, 70);
    border: 0;
    margin: 0;
}

QScrollBar:vertical {
    width: 10px;
}

QScrollBar:horizontal {
    height: 10px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: rgba(212, 212, 212, 95);
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #767676;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: 0;
}

QProgressBar {
    color: #ffffff;
    background-color: rgba(0, 0, 0, 120);
    border: 1px solid rgba(212, 212, 212, 70);
    border-radius: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #767676;
    border-radius: 5px;
}

QSlider::groove:horizontal,
QSlider::groove:vertical {
    background-color: rgba(0, 0, 0, 120);
    border-radius: 3px;
}

QSlider::groove:horizontal {
    height: 6px;
}

QSlider::groove:vertical {
    width: 6px;
}

QSlider::handle:horizontal,
QSlider::handle:vertical {
    background-color: #767676;
    border: 1px solid #1a1a1a;
    border-radius: 7px;
    width: 14px;
    height: 14px;
}

QStatusBar,
QMenuBar,
QToolBar {
    background-color: rgba(0, 0, 0, 100);
    border: 0;
}

QMenuBar::item {
    padding: 5px 8px;
}

QMenuBar::item:selected {
    color: #ffffff;
    background-color: #767676;
    border-radius: 4px;
}
